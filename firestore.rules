rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dhaba Prep Assistant MVP Security Rules
    // Allow read and write only to the 6 application collections; deny everything else

    match /items/{document} {
      allow read, write: if true;
    }
    match /dayLogs/{document} {
      allow read, write: if true;
    }
    match /partyOrders/{document} {
      allow read, write: if true;
    }
    match /prepPlans/{document} {
      allow read, write: if true;
    }
    match /closingCounts/{document} {
      allow read, write: if true;
    }
    match /morningChecks/{document} {
      allow read, write: if true;
    }

    // Explicitly deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
